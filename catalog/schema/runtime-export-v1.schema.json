{
  "$id": "https://afterglow-labs.github.io/YTABConfig/schema/runtime-export-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context": {
      "type": "object"
    },
    "exportedAt": {
      "format": "date-time",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/runtimeRecord"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": 1
    },
    "tweakVersion": {
      "minLength": 1,
      "type": "string"
    },
    "youtubeVersion": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "exportedAt",
    "youtubeVersion",
    "tweakVersion",
    "context",
    "records"
  ],
  "title": "YTABConfig runtime export v1",
  "type": "object",
  "$defs": {
    "nativeState": {
      "additionalProperties": false,
      "properties": {
        "capturedAt": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "enum": [
            "runtime",
            "unavailable"
          ]
        },
        "value": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "value",
        "source",
        "capturedAt"
      ],
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "runtime"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              },
              "capturedAt": {
                "format": "date-time",
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "capturedAt": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "overrideState": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "inherit",
            "force-on",
            "force-off"
          ]
        },
        "value": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "mode",
        "value"
      ],
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "inherit"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "force-on"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "force-off"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "runtimeRecord": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "minLength": 1,
          "type": "string"
        },
        "class": {
          "enum": [
            "YTGlobalConfig",
            "YTColdConfig",
            "YTHotConfig"
          ]
        },
        "effective": {
          "$ref": "#/$defs/valueSource"
        },
        "native": {
          "$ref": "#/$defs/nativeState"
        },
        "override": {
          "$ref": "#/$defs/overrideState"
        },
        "risk": {
          "enum": [
            "Low",
            "Medium",
            "High",
            "Unknown"
          ]
        },
        "selector": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "Verified",
            "Inferred",
            "Unknown"
          ]
        },
        "summary": {
          "oneOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "class",
        "selector",
        "native",
        "override",
        "effective",
        "title",
        "summary",
        "category",
        "risk",
        "status"
      ],
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "override": {
                "properties": {
                  "mode": {
                    "const": "force-on"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "effective": {
                "properties": {
                  "source": {
                    "const": "override"
                  },
                  "value": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "override": {
                "properties": {
                  "mode": {
                    "const": "force-off"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "effective": {
                "properties": {
                  "source": {
                    "const": "override"
                  },
                  "value": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "override": {
                "properties": {
                  "mode": {
                    "const": "inherit"
                  }
                }
              },
              "native": {
                "properties": {
                  "value": {
                    "const": null
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "effective": {
                "properties": {
                  "source": {
                    "const": "unavailable"
                  },
                  "value": {
                    "const": null
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "override": {
                "properties": {
                  "mode": {
                    "const": "inherit"
                  }
                }
              },
              "native": {
                "properties": {
                  "value": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "effective": {
                "properties": {
                  "source": {
                    "const": "native"
                  },
                  "value": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "override": {
                "properties": {
                  "mode": {
                    "const": "inherit"
                  }
                }
              },
              "native": {
                "properties": {
                  "value": {
                    "const": false
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "effective": {
                "properties": {
                  "source": {
                    "const": "native"
                  },
                  "value": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      ]
    },
    "valueSource": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "native",
            "override",
            "unavailable"
          ]
        },
        "value": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "value",
        "source"
      ],
      "type": "object"
    }
  }
}
