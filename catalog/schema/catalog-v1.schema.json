{
  "$id": "https://afterglow-labs.github.io/YTABConfig/schema/catalog-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "generatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/record"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "$ref": "#/$defs/catalogSource"
    },
    "youtubeVersion": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "youtubeVersion",
    "generatedAt",
    "source",
    "records"
  ],
  "title": "YTABConfig metadata catalog v1",
  "type": "object",
  "$defs": {
    "catalogSource": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "classCounts": {
          "items": {
            "$ref": "#/$defs/classCount"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "callsiteScan": {
          "$ref": "#/$defs/callsiteScan"
        },
        "kind": {
          "const": "decompiler-c-files"
        },
        "root": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "root",
        "files",
        "classCounts",
        "callsiteScan"
      ],
      "type": "object"
    },
    "classCount": {
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": [
            "YTGlobalConfig",
            "YTColdConfig",
            "YTHotConfig"
          ]
        },
        "headers": {
          "minimum": 0,
          "type": "integer"
        },
        "candidates": {
          "minimum": 0,
          "type": "integer"
        },
        "extracted": {
          "minimum": 0,
          "type": "integer"
        },
        "minimum": {
          "minimum": 0,
          "type": "integer"
        },
        "expected": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "class",
        "headers",
        "candidates",
        "extracted",
        "minimum",
        "expected"
      ],
      "type": "object"
    },
    "callsiteScan": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "limitPerRecord": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "enabled",
        "limitPerRecord"
      ],
      "type": "object"
    },
    "callsiteSummary": {
      "additionalProperties": false,
      "properties": {
        "observed": {
          "minimum": 0,
          "type": "integer"
        },
        "stored": {
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "observed",
        "stored",
        "truncated"
      ],
      "type": "object"
    },
    "defaultInference": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "enum": [
            "High",
            "Medium",
            "Low"
          ]
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "method": {
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "confidence",
        "method",
        "evidence"
      ],
      "type": "object"
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "excerpt": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "definition",
            "callsite"
          ]
        },
        "source": {
          "additionalProperties": false,
          "properties": {
            "address": {
              "type": [
                "string",
                "null"
              ]
            },
            "lineEnd": {
              "minimum": 1,
              "type": "integer"
            },
            "lineStart": {
              "minimum": 1,
              "type": "integer"
            },
            "path": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "path",
            "lineStart",
            "lineEnd",
            "address"
          ],
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "source",
        "excerpt"
      ],
      "type": "object"
    },
    "record": {
      "additionalProperties": false,
      "properties": {
        "callsites": {
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/evidence"
              },
              {
                "properties": {
                  "kind": {
                    "const": "callsite"
                  }
                }
              }
            ]
          },
          "type": "array"
        },
        "callsiteSummary": {
          "$ref": "#/$defs/callsiteSummary"
        },
        "category": {
          "minLength": 1,
          "type": "string"
        },
        "class": {
          "enum": [
            "YTGlobalConfig",
            "YTColdConfig",
            "YTHotConfig"
          ]
        },
        "conflicts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "defaultInference": {
          "oneOf": [
            {
              "$ref": "#/$defs/defaultInference"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "effective": {
          "$ref": "#/$defs/valueSource"
        },
        "evidence": {
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/evidence"
              },
              {
                "properties": {
                  "kind": {
                    "const": "definition"
                  }
                }
              }
            ]
          },
          "type": "array"
        },
        "experimentID": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "native": {
          "$ref": "#/$defs/nativeState"
        },
        "override": {
          "$ref": "#/$defs/overrideState"
        },
        "risk": {
          "enum": [
            "Low",
            "Medium",
            "High",
            "Unknown"
          ]
        },
        "schemaVersion": {
          "const": 1
        },
        "selector": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "Verified",
            "Inferred",
            "Unknown"
          ]
        },
        "summary": {
          "oneOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "verifiedVersions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "curationEvidence": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "curationRationale": {
          "oneOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "class",
        "selector",
        "experimentID",
        "native",
        "override",
        "effective",
        "title",
        "summary",
        "category",
        "risk",
        "dependencies",
        "conflicts",
        "status",
        "evidence",
        "callsites",
        "callsiteSummary",
        "defaultInference",
        "verifiedVersions",
        "curationEvidence",
        "curationRationale"
      ],
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "Inferred",
                  "Verified"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "curationEvidence": {
                "minItems": 1
              },
              "curationRationale": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "Unknown"
              }
            }
          },
          "then": {
            "properties": {
              "curationEvidence": {
                "maxItems": 0
              },
              "curationRationale": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "nativeState": {
      "additionalProperties": false,
      "properties": {
        "capturedAt": {
          "const": null
        },
        "source": {
          "const": "unavailable"
        },
        "value": {
          "const": null
        }
      },
      "required": [
        "value",
        "source",
        "capturedAt"
      ],
      "type": "object"
    },
    "overrideState": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "inherit"
        },
        "value": {
          "const": null
        }
      },
      "required": [
        "mode",
        "value"
      ],
      "type": "object"
    },
    "valueSource": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "unavailable"
        },
        "value": {
          "const": null
        }
      },
      "required": [
        "value",
        "source"
      ],
      "type": "object"
    }
  }
}
